{
  "rewrites": [
    {
      "source": "/uploads/:file*",
      "destination": "https://api.full-food.hotel-familyhouse.uz/uploads/:file*"
    },
    {
      "source": "/api/:match*",
      "destination": "https://api.full-food.hotel-familyhouse.uz/api/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}

