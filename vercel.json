{
  "rewrites": [
    {
      "source": "/uploads/:file*",
      "destination": "/api/img?file=:file*"
    },
    {
      "source": "/api/img",
      "destination": "/api/img"
    },
    {
      "source": "/api/:match*",
      "destination": "https://bluebird-fancy-painfully.ngrok-free.app/api/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
